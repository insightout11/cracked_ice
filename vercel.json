{
  "version": 2,
  "buildCommand": "cd server && npm install && npm run build && cd ../web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/coach/(.*)",
      "destination": "/api/coach/[...path]"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
