{
  "version": 2,
  "buildCommand": "bash build-workstation.sh",
  "outputDirectory": "workstation/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cracked-ice-web.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
