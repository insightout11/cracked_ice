{
  "version": 2,
  "buildCommand": "npm install && cd server && npm install --production=false && npm run build && cd ../web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/coach/(.*)",
      "destination": "/api/coach/[...path]"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.[jt]s": {
      "maxDuration": 30,
      "includeFiles": "{server/dist/**,data/**,server/data/**,apps/api/cache/**,apps/api/src/data/**,apps/api/data-cache/**}"
    }
  }
}
