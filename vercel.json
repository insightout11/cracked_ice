{
  "version": 2,
  "buildCommand": "bash build.sh",
  "outputDirectory": "web/dist",
  "functions": {
    "api/draft-players.ts": {
      "includeFiles": "{data/players.json,data/stats.json}"
    }
  },
  "redirects": [
    {
      "source": "/optimizer",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-analysis",
      "destination": "/season?view=season",
      "permanent": true
    },
    {
      "source": "/schedule",
      "destination": "/season",
      "permanent": true
    },
    {
      "source": "/schedule-v2",
      "destination": "/season",
      "permanent": true
    },
    {
      "source": "/help",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/coach",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/coach/roster",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/coach/press-box",
      "destination": "/season",
      "permanent": true
    },
    {
      "source": "/coach/front-office",
      "destination": "/team",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/team",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/coach/:path*",
      "destination": "/api/coach"
    },
    {
      "source": "/api/yahoo/:path*",
      "destination": "/api/yahoo"
    },
    {
      "source": "/season",
      "destination": "/season/index.html"
    },
    {
      "source": "/compare",
      "destination": "/compare/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/team",
      "destination": "/index.html"
    }
  ]
}
