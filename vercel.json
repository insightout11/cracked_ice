{
  "version": 2,
  "buildCommand": "bash build.sh",
  "outputDirectory": "web/dist",
  "functions": {
    "api/draft-players.ts": {
      "includeFiles": "{data/players.json,data/stats.json}"
    }
  },
  "redirects": [
    {
      "source": "/schedule",
      "destination": "/season",
      "permanent": true
    },
    {
      "source": "/schedule-v2",
      "destination": "/season",
      "permanent": true
    },
    {
      "source": "/help",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/coach",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/coach/roster",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/coach/press-box",
      "destination": "/season",
      "permanent": true
    },
    {
      "source": "/coach/front-office",
      "destination": "/team",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/coach/:path*",
      "destination": "/api/coach"
    },
    {
      "source": "/api/yahoo/:path*",
      "destination": "/api/yahoo"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
