{
  "version": 2,
  "buildCommand": "bash build.sh",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/coach/:path*",
      "destination": "/api/coach"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.[jt]s": {
      "maxDuration": 30,
      "includeFiles": "{server/dist/**,data/**,server/data/**,apps/api/cache/**,apps/api/src/data/**,apps/api/data-cache/**}"
    }
  }
}
