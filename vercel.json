{
  "version": 2,
  "buildCommand": "cd server && npm install && npm run build && cd ../web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/coach/(.*)",
      "destination": "/api/coach/[...path].cjs"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.cjs": {
      "maxDuration": 30,
      "includeFiles": "server/dist/**"
    },
    "api/**/*.[jt]s": {
      "maxDuration": 30,
      "includeFiles": "server/dist/**"
    }
  }
}
