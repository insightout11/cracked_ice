{
  "version": 2,
  "name": "crackedice-workstation",
  "buildCommand": "cd workstation && npm install && npm run build",
  "outputDirectory": "workstation/dist",
  "installCommand": "cd workstation && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cracked-ice-web.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
