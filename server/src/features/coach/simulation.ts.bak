import { PlayerProjection, SimulationResult, SimulationStartRecord, SimulationBenchRecord } from './types';
import { DateWindow } from './scoring';

export function buildDateRange(window: DateWindow): string[] {
  const dates: string[] = [];
  const cursor = new Date(`${window.start}T00:00:00Z`);
  const end = new Date(`${window.end}T00:00:00Z`);

  while (cursor.getTime() <= end.getTime()) {
    dates.push(cursor.toISOString().slice(0, 10));
    cursor.setUTCDate(cursor.getUTCDate() + 1);
  }

  return dates;
}

function normalizePositions(playerPosition: string): string[] {
  return playerPosition
    .split('/')
    .map((pos) => pos.trim().toUpperCase())
    .filter(Boolean)
    .map((pos) => {
      if (pos === 'L') return 'LW';
      if (pos === 'R') return 'RW';
      return pos;
    });
}

/**
 * Check if a player is eligible for a given position slot.
 * Handles multi-position eligibility (e.g., "LW/RW", "C/LW").
 */
function isEligibleForPosition(playerPosition: string, slotPosition: string): boolean {
  const positions = normalizePositions(playerPosition);
  const slot = slotPosition.toUpperCase();
  const isForward = positions.some((pos) => pos === 'C' || pos === 'LW' || pos === 'RW' || pos === 'W' || pos === 'F');
  const isSkater = positions.some((pos) => pos !== 'G');

  switch (slot) {
    case 'F':
      return isForward;
    case 'W':
      return positions.some((pos) => pos === 'LW' || pos === 'RW' || pos === 'W');
    case 'UTIL':
    case 'U':
    case 'FLEX':
      return isSkater;
    case 'D':
      return positions.includes('D');
    case 'G':
      return positions.includes('G');
    default:
      return positions.includes(slot);
  }
}

export function simulateLineup(
  projections: PlayerProjection[],
  window: DateWindow,
  lineupSlots: Record<string, number>
): SimulationResult {
  const startsByPlayer = new Map<string, number>();
  const startRecords: SimulationStartRecord[] = [];
  const benchRecords: SimulationBenchRecord[] = [];
  let totalPoints = 0;

  const calendar = buildDateRange(window);

  for (const day of calendar) {
    const usedIds = new Set<string>();

    for (const [position, limit] of Object.entries(lineupSlots)) {
      if (limit <= 0) continue;
      const normalizedSlot = position.toUpperCase();
      if (normalizedSlot === 'BN' || normalizedSlot === 'BENCH' || normalizedSlot === 'IR' || normalizedSlot === 'IR+') {
        continue;
      }

      const available = projections
        .filter((projection) =>
          isEligibleForPosition(projection.base.position, position) &&
          projection.upcomingGamesInWindow.includes(day)
        )
        .filter((projection) => !usedIds.has(projection.base.id))
        .sort((a, b) => b.fppg - a.fppg || b.projectedPoints - a.projectedPoints);

      const starters = available.slice(0, limit);
      const benched = available.slice(limit);

      for (const starter of starters) {
        usedIds.add(starter.base.id);
        totalPoints += starter.fppg;
        startsByPlayer.set(
          starter.base.id,
          (startsByPlayer.get(starter.base.id) ?? 0) + 1
        );
        startRecords.push({
          playerId: starter.base.id,
          playerName: starter.base.full_name,
          position,
          date: day,
          fppg: starter.fppg
        });
      }

      for (const bench of benched) {
        benchRecords.push({
          playerId: bench.base.id,
          playerName: bench.base.full_name,
          position,
          date: day,
          fppg: bench.fppg,
          reason: 'slot_filled'
        });
      }
    }
  }

  return {
    totalPoints: Number(totalPoints.toFixed(2)),
    startsByPlayer,
    startRecords,
    benchRecords
  };
}

