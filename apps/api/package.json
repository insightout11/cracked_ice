{
  "name": "cracked-ice-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "vitest",
    "hydrate": "node scripts/hydrate.mjs",
    "hydrate:local": "pnpm hydrate && node scripts/manifest.mjs",
    "manifest": "node scripts/manifest.mjs",
    "hydrate:teams": "node ./scripts/hydrate-team-stats.mjs",
    "show:cache": "node ./scripts/print-cache-state.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}