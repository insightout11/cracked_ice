PORT=3000
NODE_ENV=development
NEXT_PUBLIC_ENV=staging
DISABLE_PROD=true
ALLOW_ORIGIN=http://localhost:3000
FEATURE_OCR=false
FEATURE_MULTI_MOVE=false
FEATURE_CUSTOM_SCORING=false
NHL_STATS_BASE=https://statsapi.web.nhl.com
HYDRATE_TIMEOUT_MS=20000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SCHEMA=public
SUPABASE_CACHE_BUCKET=
BOOT_SYNC_CACHE=true

# NHL API settings
NHL_API_BASE_URL=https://statsapi.web.nhl.com/api/v1
CACHE_TTL_HOURS=24

# Yahoo Fantasy API (for future use)
YAHOO_CLIENT_ID=your_client_id
YAHOO_CLIENT_SECRET=your_client_secret
YAHOO_REDIRECT_URI=http://localhost:3000/auth/callback
DISABLE_LIVE_STATS=true

STATS_SEASON=20242025
